# Salin ke .env lalu ekspor sebelum menjalankan (atau set di systemd/Docker).
PORT=8787
HOST=127.0.0.1                 # jangan 0.0.0.0 tanpa GARDA_API_TOKEN + reverse proxy HTTPS
DB_PATH=./data/garda.db
GARDA_API_TOKEN=               # isi dengan string acak panjang untuk mewajibkan token
GARDA_CONTACT=redaksi@contoh.org   # dicantumkan di User-Agent pengumpul (praktik etis)
SCHEDULER=true                 # false = hanya pengumpulan manual
FOUR_EYES=true                 # vonis "Tidak benar/Menyesatkan" butuh pemeriksa kedua
HOST_DELAY_MS=3000             # jeda minimum antar-permintaan ke host yang sama
MIN_INTERVAL_MIN=15            # interval minimum per sumber
MAX_AGE_DAYS=14                # item lebih tua dari ini dibuang
SEED_DEMO=true                 # muat data demo bila database kosong
ALLOW_PRIVATE_HOSTS=false      # true HANYA untuk pengujian lokal (menonaktifkan proteksi SSRF)
RATE_LIMIT=300                 # permintaan API per menit per IP
